            },
            {
              "max_days": 7,
              "label": "02. 2 to 7 Days"
            },
            {
              "max_days": 30,
              "label": "03. 8 to 30 Days"
            },
            {
              "max_days": 90,
              "label": "04. 1 to 3 Months (31-90d)"
            },
            {
              "max_days": 180,
              "label": "05. 3 to 6 Months (91-180d)"
            },
            {
              "max_days": 365,
              "label": "06. 6 to 12 Months (181-365d)"
            },
            {
              "max_days": 1095,
              "label": "07. 1 to 3 Years"
            },
            {
              "max_days": 1825,
              "label": "08. 3 to 5 Years"
            }
          ],
          "overflow_label": "09. Over 5 Years",
          "overdue_label": "10. Overdue / Matured Unencashed",
          "null_sight_label": "01. Overnight / Sight (Non-Maturing)",
          "null_long_label": "09. Over 5 Years (Core)"
