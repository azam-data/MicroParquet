    {
      "ConditionalColumn": {
        "new_col": "Is_Dormant",
        "rules": [
          {
            "col_name": "Acstat",
            "op": "Eq",
            "compare_val": "DMT",
            "output_val": "Y"
          }
        ],
        "fallback": "N",
        "output_as_float": false
      }
    },
    {
      "MathFormula": {
        "new_col": "Balance_Cr",
        "left_col": "Balance",
        "op": "Div",
        "right_is_col": false,
        "right_val_or_col": "10000000"
      }
    },
    {
      "NormalizeEntity": {
        "source_col": "Acttit",
        "new_col": "Acttit_Norm"
      }
    },
    {
      "MaturityBucket": {
