{
  "name": "Phase 2",
  "description": "Every step type, saved by the Phase 2 code (merge commit 4278ef5).",
  "created_at": "4278ef5",
  "enforce_balance_control": true,
  "control_column": "Balance",
  "optional_ingestion_schema": null,
  "steps": [
